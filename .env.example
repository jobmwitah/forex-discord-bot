# Required: create a bot at https://discord.com/developers/applications
# and paste its token here.
DISCORD_TOKEN=

# Optional: your server ID. When set, slash commands sync instantly to that
# server while developing. Leave empty to sync globally (can take up to 1 hour).
GUILD_ID=

# Optional: fallback alert channel ID for servers that have not run /setup yet.
# Prefer /setup channel:#alerts inside Discord.
ALERT_CHANNEL_ID=

# Defaults applied to servers that have not configured themselves.
# You can override everything per server with /setup.
DEFAULT_CURRENCIES=EUR,USD,GBP,JPY,AUD,CAD,CHF,NZD
DEFAULT_MIN_IMPACT=high
DEFAULT_DIGEST_TIME=08:00
DEFAULT_REMINDERS=15,60
DEFAULT_TIMEZONE=UTC

# Send an alert at the exact release time and a post-release summary with the
# actual value. Can be toggled per server with /setup.
DEFAULT_RELEASE_ALERTS=true
DEFAULT_RELEASE_SUMMARY=true

# How long to cache the ForexFactory feed, in seconds.
FEED_TTL_SECONDS=600

# Post-release summary timing, in seconds. The bot waits DELAY after the event
# before looking for the actual value, then retries until MAX_WAIT has passed.
RELEASE_SUMMARY_DELAY_SECONDS=30
RELEASE_SUMMARY_MAX_WAIT_SECONDS=900

# Optional free social posting. Leave these empty to disable it.
# X goes through Buffer's free plan (X's own API is pay-per-use):
#   1. Connect X to Buffer, create a key at https://publish.buffer.com/settings/api
#   2. Set BUFFER_API_KEY here, run `python social.py --channels`,
#      then paste the X channel's id into BUFFER_CHANNEL_ID.
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
# off | reminder | release | summary | all
X_POST_MODE=reminder

# Bluesky is posted to directly with its free AT Protocol API. Create an app
# password in Bluesky Settings -> App Passwords; never use the main password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS=https://bsky.social
# off | reminder | release | summary | all
BLUESKY_POST_MODE=all

# Currency/impact/time filters for social posts. SOCIAL_CURRENCIES empty means
# every currency; SOCIAL_TIMEZONE only affects the times printed in posts.
SOCIAL_CURRENCIES=
SOCIAL_MIN_IMPACT=high
SOCIAL_REMINDER_MINUTES=15
SOCIAL_TIMEZONE=UTC

# Branded image cards (2400x1350, 2x supersampled). Rendered locally with Pillow; no AI service.
SOCIAL_IMAGES=true
SOCIAL_BRAND_NAME=Pipwire
SOCIAL_BRAND_HANDLE=
# Optional font override; empty uses assets/fonts/Inter-Variable.ttf.
SOCIAL_FONT_PATH=

# X cannot receive file uploads through Buffer, so cards are posted to a public
# Cloudinary URL. Cloudinary's free tier is enough for hundreds of cards/month.
# Create an account at https://cloudinary.com, then copy the three values from
# the dashboard. Bluesky images work without Cloudinary (direct blob upload).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
