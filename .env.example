# Required: create a bot at https://discord.com/developers/applications
# and paste its token here.
DISCORD_TOKEN=

# Optional: your server ID. When set, slash commands sync instantly to that
# server while developing. Leave empty to sync globally (can take up to 1 hour).
GUILD_ID=

# Optional: fallback alert channel ID for servers that have not run /setup yet.
# Prefer /setup channel:#alerts inside Discord.
ALERT_CHANNEL_ID=

# Defaults applied to servers that have not configured themselves.
# You can override everything per server with /setup.
DEFAULT_CURRENCIES=EUR,USD,GBP,JPY,AUD,CAD,CHF,NZD
DEFAULT_MIN_IMPACT=high
DEFAULT_DIGEST_TIME=08:00
DEFAULT_REMINDERS=15,60
DEFAULT_TIMEZONE=UTC

# How long to cache the ForexFactory feed, in seconds.
FEED_TTL_SECONDS=600
